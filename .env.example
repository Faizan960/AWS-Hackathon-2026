# Optional Amazon Bedrock planner. The API works without AWS credentials.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Use an existing named profile (for example: default). Do not put keys here.
# AWS_PROFILE=default
# Deterministic mode, avoiding any Bedrock call:
# ACTIONFLOW_LOCAL_ONLY=1
# Optional persistence directory override:
# ACTIONFLOW_DATA_DIR=./.actionflow-data
# Optional API port:
# API_PORT=3001
